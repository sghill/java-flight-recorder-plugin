<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="Java Flight Recorder">
        <f:entry title="JFR Dumps Directory" field="jfrDumpsDirectory">
            <f:textbox />
        </f:entry>
        <f:entry title="Max Concurrent Sessions" field="maxConcurrentSessions">
            <f:number clazz="positive-number" min="1" max="5" default="5" />
        </f:entry>
    </f:section>
</j:jelly>
